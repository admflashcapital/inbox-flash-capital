# ═══════════════════════════════════════════════════════════════════
# Inbox Flash Capital — variáveis da central (STORY-1.1 / EPIC-1)
# ═══════════════════════════════════════════════════════════════════
# Copie para `.env` e preencha. O `.env` é gitignored (AD-8) e
# NUNCA vai para o repo, para o runbook, nem para o chat.
#
#   cp .env.example .env
#
# Gerar os segredos (cada um é único por ambiente — staging ≠ produção):
#   SECRET_KEY_BASE ........ openssl rand -hex 64
#   senhas de banco/redis .. openssl rand -base64 32 | tr -d '/+=' | head -c 32
#
# Var nova aqui → placeholder + comentário → só então usar no compose.
# ═══════════════════════════════════════════════════════════════════

# ── Onde a central escuta (AD-10) ──────────────────────────────────
# A central publica UMA porta, em LOOPBACK, e ela existe só para o navegador
# do colaborador. Nada de 0.0.0.0: sem TLS, nada de LAN.
# Parametrizada porque a 3001 é disputada com o front de dev do monorepo
# (api/common/origins.py lista localhost:3001 como origem).
# Mudou aqui? Mude a CENTRAL_URL_PUBLICA junto.
CHATWOOT_HOST_PORT=3001

# ── Chatwoot ───────────────────────────────────────────────────────
# AD-7/FR-2: tag CE explícita. NUNCA `latest`. Upgrade = bump aqui +
# validação em staging (docs/runbook-upgrade.md).
CHATWOOT_TAG=v4.15.1-ce

# URL da central — o Chatwoot monta links de e-mail/notificação e o redirect
# do OAuth do Google a partir dela. Precisa bater com a porta publicada E com
# o Authorized redirect URI registrado no Google Cloud (<CENTRAL_URL_PUBLICA>/google/callback).
CENTRAL_URL_PUBLICA=http://localhost:3001

# Assina cookies e sessões do Rails. `openssl rand -hex 64`.
# Trocar depois de subir INVALIDA todas as sessões — gere uma vez por ambiente.
SECRET_KEY_BASE=

# Sem proxy na frente e em loopback puro, não há TLS a forçar: `true` aqui
# faria o Rails redirecionar para https:// e a central deixaria de abrir.
FORCE_SSL=false

# Central de uso interno: signup público FECHADO. As contas de agente são
# criadas pelo admin (STORY-6.1). Não mudar sem motivo.
ENABLE_ACCOUNT_SIGNUP=false

# Log estruturado no stdout (o Docker coleta) — STORY-6.3.
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Log em JSON (lograge). Sem isto o Rails escreve texto puro e ninguem filtra
# por remote_ip, user_id ou params quando precisa reconstituir um incidente.
LOGRAGE_ENABLED=true

# Anexos das conversas em volume local (`storage_data`), não em S3.
# Volume pequeno; o backup cobre o volume (STORY-1.4).
ACTIVE_STORAGE_SERVICE=local

# Anti-SSRF do Chatwoot (`SafeFetch`): por padrão ele RECUSA webhook e download
# de mídia em host sem IP público. Esteve `true` só enquanto existiu o canal de
# prospecção — a Evolution vivia na rede Docker compartilhada, sem IP público.
# Com a Evolution fora (AD-11), nada mais precisa disso: a proteção volta a valer.
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=false

# ── Postgres da central (AD-9 — banco PRÓPRIO) ─────────────────────
# ⚠️ NUNCA aponte estas variáveis para o Postgres do Twenty (CRM) nem
# para o Supabase (monorepo). A central tem banco próprio, sem conexão
# cruzada. O host é o serviço `postgres` DESTE compose.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_production
# Usuário da aplicação (não-superusuário, dono do banco).
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=
# Superusuário do container Postgres (só o init script e o backup usam).
POSTGRES_SUPERUSER_PASSWORD=

# ── Redis (fila do Sidekiq) ────────────────────────────────────────
# A senha entra na URL: o Chatwoot lê REDIS_URL, o container lê REDIS_PASSWORD.
# Mantenha os dois com a MESMA senha.
REDIS_PASSWORD=
REDIS_URL=redis://:SENHA_DO_REDIS@redis:6379

# ── E-mail transacional (convite de agente, reset de senha) ────────
# Não é o canal de atendimento (esse é a inbox `E-mail`, EPIC-4) — é só o
# SMTP que o Chatwoot usa para falar com os PRÓPRIOS agentes.
# Aspas obrigatórias: o valor tem `<` e `>` (o shell interpretaria como redirect).
MAILER_SENDER_EMAIL="Flash Capital <nao-responda@flashcapital.com.br>"
SMTP_DOMAIN=flashcapital.com.br
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

# ── Credenciais de API da central ──────────────────────────────────
# Usadas pelos scripts de operação (`conectar-twilio.sh`, `conectar-gmail.sh`,
# `verificar-*.sh`) e pelo monorepo, que espelha os disparos (AD-6).

# Conta do Chatwoot (a primeira conta criada no onboarding costuma ser id 1).
CENTRAL_ACCOUNT_ID=1
# Access token de um usuário ADMIN do Chatwoot. Gerado na UI (Perfil → Access
# Token). É o MESMO valor de `CHATWOOT_ACCESS_TOKEN` no .env do monorepo, que
# espelha os disparos. Trate como senha.
CENTRAL_ACCESS_TOKEN=

# ── Canal WhatsApp Oficial — Twilio (STORY-3.1 / EPIC-3) ───────────
# O número OFICIAL é o canal de DINHEIRO (cobrança e transacional). Ele já
# existe e já é usado pelo monorepo — aqui a central só o ESPELHA.
#
# As credenciais são as MESMAS do monorepo (`TWILIO_ACCOUNT_SID` /
# `TWILIO_AUTH_TOKEN` de lá). Não crie conta nova, não gere token novo: dois
# tokens para a mesma conta só multiplicam o que precisa ser rotacionado.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# O número oficial em E.164, SEM o prefixo `whatsapp:` (o Chatwoot o adiciona).
# É o mesmo do `TWILIO_OFFICIAL_PHONE_NUMBER` no monorepo.
TWILIO_NUMERO_OFICIAL=
# Nome da inbox — FIXO pelo glossário do PRD. Não invente sinônimo.
INBOX_OFICIAL_NOME=WhatsApp Oficial

# Token compartilhado do FAN-OUT do inbound Twilio (AD-8).
# `openssl rand -hex 32`
#
# Por que existe: o `Twilio::CallbackController` do Chatwoot NÃO confere o
# `X-Twilio-Signature` — só filtra os params e enfileira o job. Exposto na
# internet, qualquer um forjaria uma mensagem inbound na central.
#
# Quem valida a assinatura da Twilio é o MONOREPO: é ele o dono do webhook do
# número oficial (a resposta do cliente alimenta a confirmação de sacado) e é
# dele que o evento chega aqui, relayado. O Caddy então barra `/twilio/callback`
# vindo de fora, aceitando só quem apresenta este token no header
# `X-Relay-Token`. O MESMO valor precisa estar no `.env` do monorepo
# (`CHATWOOT_RELAY_TOKEN`).
RELAY_TOKEN=

# ── Canal E-mail — Gmail Workspace por OAuth (STORY-4.1 / EPIC-4) ──
# A caixa de atendimento entra como inbox `E-mail`. O Chatwoot fala IMAP
# (recebe) e SMTP (responde) com a Gmail usando XOAUTH2.
#
# ⚠️ SERVICE ACCOUNT NÃO SERVE AQUI. O Chatwoot só sabe o fluxo OAuth de
# USUÁRIO (3-legged): o `Google::RefreshOauthTokenService` renova o token com
# `grant_type=refresh_token` e levanta `'A refresh_token is not available'` se
# ele faltar. Service account usa o grant JWT-bearer e NUNCA emite
# refresh_token — não existe caminho de código para ela. Injetar um token de SA
# na marra faria o canal funcionar por 1h e morrer em silêncio dentro do job.

# O endereço da caixa de atendimento (não é segredo).
GMAIL_CAIXA_ATENDIMENTO=
# Nome da inbox — FIXO pelo glossário do PRD. Não invente sinônimo.
INBOX_EMAIL_NOME=E-mail

# Credencial do OAuth Client (tipo "Web application") criado no Google Cloud.
# Pode ser no MESMO projeto onde a service account já vive.
# Tela de consentimento INTERNAL (é Workspace) ⇒ o escopo restrito
# `https://mail.google.com/` NÃO passa por revisão do Google.
# Redirect URI autorizado: <CENTRAL_URL_PUBLICA>/google/callback
# Passo a passo: docs/runbook-canal-email.md. Trate o secret como senha.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Criptografia at-rest do Active Record ──────────────────────────
# As 3 juntas ligam `encrypts` no Chatwoot (lib: Chatwoot.encryption_configured?).
# Gerar: docker compose exec chatwoot-web bundle exec rails db:encryption:init
#
# O que ELAS protegem: `imap_password`/`smtp_password` de canal de e-mail com
# senha, e habilitam MFA de agente (EPIC-6).
#
# ⚠️ O que elas NÃO protegem: o `provider_config` do Channel::Email — é jsonb e
# o Chatwoot NÃO o criptografa. Com OAuth, o refresh_token do Gmail (escopo
# `https://mail.google.com/`, sem expiração) fica em TEXTO PURO no Postgres e
# dentro de todo backup. É dívida técnica conhecida (PROGRESS.md); mitigação é
# tratar o BACKUP_DIR como segredo e revogar o token no Google Admin Console se
# vazar. Corrigir exigiria forkar o Chatwoot — proibido (AD-7).
#
# ⚠️ PERDER ESTAS CHAVES = NÃO CONSEGUIR MAIS DECIFRAR O QUE JÁ FOI GRAVADO.
# Guarde junto com o SECRET_KEY_BASE. Únicas por ambiente (staging ≠ produção).
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# ── Backup e retenção (STORY-1.4) ──────────────────────────────────
# Diretório no HOST onde os dumps são gravados. Fora do repo em produção
# (ex.: /srv/backups/inbox). Contém PII de conversa — trate como segredo.
BACKUP_DIR=./backups

# Retenção de conversa (LGPD). Conversas RESOLVIDAS mais velhas que isto são
# apagadas por `scripts/retencao-conversas.sh` (com mensagens e anexos).
# Default 1825 dias = 5 anos, alinhado à prescrição civil de dívida — a central
# guarda a conversa de COBRANÇA, e apagar cedo demais destrói a prova da
# negociação. Confirmar com o jurídico antes de agendar (STORY-6.3).
RETENCAO_CONVERSAS_DIAS=1825

# ── Sonda de saúde dos canais (STORY-6.3) ──────────────────────────
# Para onde o monitorar-canais.sh posta o alerta que aparece no sino do Nexus.
MONITOR_URL=http://127.0.0.1:8001
# MESMO valor do MONITOR_TOKEN no .env do monorepo. Gere com: openssl rand -hex 32
MONITOR_TOKEN=
