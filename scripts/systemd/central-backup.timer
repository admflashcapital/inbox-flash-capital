[Unit]
Description=Dispara o backup diário da central (com recuperação de dias perdidos)

[Timer]
# ── Por que timer e não cron ──────────────────────────────────────
# Medido em 08/09/2026: das 5 linhas de cron instaladas, só a do monitor
# (de hora em hora) alguma vez rodou. As quatro da madrugada tiveram ZERO
# execuções em três semanas, porque esta máquina vive das ~11h às ~19h e
# passa todo fim de semana desligada. Cron não tem memória: hora perdida é
# hora perdida, e cron de usuário não é coberto por anacron.
#
# `Persistent=true` é exatamente a memória que faltava — o systemd grava o
# último disparo em /var/lib/systemd/timers e, se a hora marcada passou com
# a máquina desligada, executa na próxima vez que ela subir. O horário deixa
# de ser uma promessa sobre quando a máquina estará ligada e vira só uma
# preferência.
#
# 12:10 e não de madrugada: é horário em que a máquina está viva de fato.
# Se estiver, roda na hora; se não, roda assim que subir.
OnCalendar=*-*-* 12:10:00
Persistent=true
Unit=central-backup.service

[Install]
WantedBy=timers.target
