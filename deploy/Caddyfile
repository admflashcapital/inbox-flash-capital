# ═══════════════════════════════════════════════════════════════════
# Caddy — porta de entrada da central (STORY-1.1 / EPIC-1)
# ═══════════════════════════════════════════════════════════════════
# Todo tráfego externo passa por aqui. O Rails do Chatwoot não publica
# porta no host (AD-8: TLS sempre; superfície mínima).
#
#   https://inbox.<DOMAIN>  → Chatwoot (UI de atendimento + API)
#
# TLS parametrizado por $DOMAIN — um único Caddyfile serve os dois ambientes:
#   • dev  (DOMAIN=localhost)          → CA interna do Caddy (self-signed),
#                                         sem ACME, sem DNS público.
#   • prod (DOMAIN=flashcapital.com.br) → Let's Encrypt automático, usando
#                                         $ADMIN_EMAIL no ACME. Exige o DNS de
#                                         inbox.<DOMAIN> já apontando para o host.
# ═══════════════════════════════════════════════════════════════════

{
	# E-mail do ACME (Let's Encrypt em prod). Em dev (*.localhost) o Caddy usa
	# a CA interna e ignora o ACME — o valor fica inerte.
	email {$ADMIN_EMAIL:admin@localhost}
}

# Cabeçalhos de segurança dos vhosts HTTPS.
(seguranca) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Não revela a versão do servidor.
		-Server
	}
}

# Health/landing em HTTP simples (sem redirect p/ HTTPS) — usado pelo
# healthcheck do container e como sanity check do proxy.
http://localhost {
	respond "Inbox Flash Capital — Caddy OK" 200
}

# UI + API do Chatwoot.
inbox.{$DOMAIN:localhost} {
	import seguranca

	# ── Inbound da Twilio: entra só com o token do relay (EPIC-3) ──
	# O Twilio::CallbackController do Chatwoot NÃO confere o X-Twilio-Signature
	# (só filtra os params e enfileira o job). Aberto na internet, qualquer um
	# forjaria uma mensagem inbound na central.
	#
	# Quem valida a assinatura é o MONOREPO: é ele o dono do webhook do número
	# oficial (usa a resposta do cliente para a confirmação de sacado) e é dele
	# que o evento chega aqui, por fan-out. Então este path não precisa — e não
	# deve — aceitar chamada direta da internet.
	#
	# Falha fechada: sem RELAY_TOKEN no .env, o default abaixo não casa com
	# nada e todo POST leva 403.
	@callback_sem_token {
		path /twilio/callback*
		not header X-Relay-Token "{$RELAY_TOKEN:relay-token-nao-configurado}"
	}
	respond @callback_sem_token 403

	# Só quem apresentou o token é que ganha a ponte (ver abaixo).
	@com_token header Api-Access-Token *

	reverse_proxy chatwoot-web:3000 {
		# O Chatwoot usa ActionCable (WebSocket) para atualizar a conversa em
		# tempo real — o Caddy faz proxy de WebSocket por padrão. Os headers
		# abaixo dizem ao Rails que a ponta externa é HTTPS (senão ele monta
		# URL de asset/redirect em http e o navegador bloqueia o mixed content).
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}

		# ── Ponte para o token da API do Chatwoot ──────────────────
		# O Caddy 2.11 DESCARTA todo header cujo nome contenha underscore
		# (defesa contra request smuggling — o log dele diz literalmente
		# "dropping header containing underscore"). Não há opção para
		# desligar isso.
		#
		# E o Chatwoot autentica a API com exatamente `api_access_token`.
		# Resultado: um cliente de API que chame a central pela URL PÚBLICA
		# tem o token silenciosamente removido e leva 401 — sem pista nenhuma
		# de por quê.
		#
		# Ponte: o cliente manda `api-access-token` (com hífen, que sobrevive)
		# e nós reconstruímos o nome que o Rails espera. Quando o header não
		# vem, o valor fica vazio; o Chatwoot usa `.present?`, então header
		# vazio é ignorado e a sessão por cookie (a UI) continua funcionando.
		#
		# Isto NÃO afeta quem fala com a central pela rede interna
		# (`chatwoot-web:3000`) — Evolution, scripts e o espelho do monorepo
		# não passam pelo Caddy e usam o header normal.
		#
		# CONDICIONAL de propósito (`@com_token`): sem o matcher, o Caddy injeta
		# `api_access_token: ""` em TODA requisição, inclusive as do navegador.
		# Hoje o Chatwoot ignora (usa `.present?`), mas depender disso é apostar
		# que nenhum caminho do Rails vai preferir um header vazio à sessão.
		header_up @com_token api_access_token {http.request.header.Api-Access-Token}
	}

	# Anexos e uploads de conversa (ActiveStorage) — cliente manda PDF de
	# nota fiscal/contrato; o default do Caddy (~10MB) cortaria.
	request_body {
		max_size 40MB
	}
}
